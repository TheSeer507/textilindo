# Copia este archivo como .env y rellena los valores.
# Se sacan de Supabase → Project Settings → API Keys.
#
# La clave "publishable" es pública por diseño: viaja al navegador y está
# protegida por las políticas RLS de la base de datos.
# La clave "secret" NUNCA va aquí ni en el navegador — solo en el servidor.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
