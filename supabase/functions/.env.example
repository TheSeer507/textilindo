# Copiar como .env y rellenar. NUNCA subir el .env a git.
# Estas claves son de SERVIDOR: no llevan prefijo VITE_ y jamás
# deben terminar en el paquete del navegador.
PF_ENV=sandbox          # sandbox | production
PF_CCLW=
PF_TOKEN=
PF_SECRET=
# Medios que muestra el checkout: CARD, CASH o "CARD,CASH"
PF_CARD_TYPE=CARD

PF_RETURN_URL=https://textilindopanama.com/#pago

# Consulta de transacción. Debe contener {oper}, que se reemplaza
# por el número de operación. Mientras esté vacío, un pago que vuelve
# del navegador se marca "reportado" y queda para revisar a mano.
# Pendiente de confirmar la ruta exacta con soporte de PagueloFacil.
PF_TX_LOOKUP_URL=
